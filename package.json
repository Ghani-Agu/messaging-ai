{
  "name": "messaging-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-channel AI messaging SaaS for MENA SMBs (WhatsApp, Instagram, web widget; AR/FR/EN/Darija).",
  "workspaces": [
    "widget"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "check:env": "tsx scripts/check-env.ts",
    "grant:superadmin": "dotenv -e .env.local -- tsx scripts/grant-superadmin.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "worker": "dotenv -e .env.local -- tsx --conditions=react-server scripts/worker.ts",
    "dev:all": "concurrently -k -n web,worker -c magenta,cyan \"npm:dev\" \"npm:worker\"",
    "queue:ping": "dotenv -e .env.local -- tsx --conditions=react-server scripts/queue-ping.ts",
    "simulate:stale": "dotenv -e .env.local -- tsx --conditions=react-server scripts/simulate-stale-conversation.ts",
    "verify:phase7": "dotenv -e .env.local -- tsx --conditions=react-server scripts/verify-phase7.ts",
    "probe:model": "dotenv -e .env.local -- tsx scripts/probe-anthropic-model.ts",
    "probe:schema": "dotenv -e .env.local -- tsx --conditions=react-server scripts/probe-schema-split.ts",
    "probe:cache": "dotenv -e .env.local -- tsx --conditions=react-server scripts/probe-cache-effectiveness.ts",
    "probe:smart-import": "dotenv -e .env.local -- tsx --conditions=react-server scripts/probe-smart-import.ts",
    "widget:dev": "npm --workspace @messaging-ai/widget run dev",
    "widget:build": "npm run widget:check-tokens && npm --workspace @messaging-ai/widget run build",
    "widget:tokens": "tsx scripts/generate-widget-tokens.ts",
    "widget:check-tokens": "tsx scripts/generate-widget-tokens.ts --check",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run widget:check-tokens"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.92.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.105.0",
    "bullmq": "^5.76.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.0",
    "geist": "^1.3.1",
    "ioredis": "^5.10.1",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^2.1.9",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.1.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
