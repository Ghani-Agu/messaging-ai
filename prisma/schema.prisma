// Prisma schema — multi-tenancy foundation (Phase 1)
// Phase 1 scope: Tenant, User, TenantUser + NextAuth tables (Account,
// Session, VerificationToken). Phase 2 will use the NextAuth tables; later
// phases add Channel, Customer, Conversation, Message, KnowledgeSource,
// KnowledgeChunk, Escalation, AuditLog, UsageRecord per MASTER_PLAN §6.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  // `vector` is pgvector — the only extension our code actively uses (Phase 3
  // embeddings); Supabase installs it in `public`. The other four are
  // pre-installed by Supabase across two dedicated schemas: the standard
  // utilities live in `extensions`, and `supabase_vault` lives in `vault`.
  // Schema annotations match the actual DB layout so drift detection passes.
  extensions = [pg_stat_statements(schema: "extensions"), pgcrypto(schema: "extensions"), plpgsql, supabase_vault(schema: "vault"), uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

// =====================================================================
// Multi-tenancy core
// =====================================================================

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SourceType {
  WEBSITE
  FILE
  MANUAL
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  WIDGET
  MESSENGER
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ConversationStatus {
  ACTIVE
  PAUSED
  CLOSED
  HUMAN_HANDLING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN_AGENT
}

enum MessageContentType {
  TEXT
  IMAGE
  VOICE
  FILE
}

enum ItemAvailability {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

model Tenant {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  logoUrl          String?
  accentColor      String? // hex; falls back to design-system violet at the app layer
  plan             Plan         @default(FREE)
  stripeCustomerId String?      @unique
  settings         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  members          TenantUser[]
  lastUsedByUsers  User[]            @relation("UserLastTenant")
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  knowledgeItems   KnowledgeItem[]
  qnaPairs         QnaPair[]
  knowledgeGaps    KnowledgeGap[]
  operationalFacts OperationalFacts?
  channels         Channel[]
  customers        Customer[]
  conversations    Conversation[]
  messages         Message[]

  @@index([slug])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime? // NextAuth
  name          String?
  image         String?
  // Platform-level admin flag — gates the /admin super-admin route. Toggled
  // out-of-band (e.g. via prisma studio); no self-service surface in v1.
  isSuperAdmin  Boolean      @default(false)
  // Most-recently-active workspace, set on tenant switch and consulted by
  // /post-auth to decide where to land the user. Cleared if the tenant is
  // deleted (SetNull rather than Cascade).
  lastUsedTenantId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenants               TenantUser[]
  accounts              Account[]
  sessions              Session[]
  lastUsedTenant        Tenant?        @relation("UserLastTenant", fields: [lastUsedTenantId], references: [id], onDelete: SetNull)
  assignedConversations Conversation[] @relation("ConversationAssignedUser")
  sentMessages          Message[]      @relation("MessageSenderUser")

  @@index([email])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

// =====================================================================
// NextAuth — wired now so Phase 2 doesn't need a schema migration on day 1
// (https://authjs.dev/getting-started/adapters/prisma)
// =====================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
// Knowledge (Phase 3)
// =====================================================================
//
// KnowledgeSource is the unit a tenant manages in the UI: a website crawl,
// a parsed file, or a manual entry. KnowledgeChunk holds the embedded text
// that retrieval queries.
//
// Two columns are declared as Unsupported because Prisma's PSL can't model
// them: `embedding` (pgvector vector(1024)) and `searchVector` (Postgres
// tsvector, populated as a GENERATED column). Both are read/written via raw
// SQL in src/server/db/knowledge.ts. Prisma still tracks them for drift
// detection so prisma migrate dev stays happy.
//
// Indexes (HNSW on embedding, GIN on searchVector) and the GENERATED clause
// on searchVector are added via raw SQL appended to the init migration.

model KnowledgeSource {
  id             String       @id @default(cuid())
  tenantId       String
  type           SourceType
  // Display name: hostname for WEBSITE, filename for FILE, user-supplied for MANUAL.
  name           String
  // Root URL for WEBSITE; storage path for FILE; null for MANUAL.
  sourceUrl      String?
  status         SourceStatus @default(PENDING)
  // Last error message captured when status=ERROR. Cleared on re-ingest.
  error          String?
  // Live progress from the worker — shape:
  //   { totalPages?: int, pagesCrawled?: int, totalChunks?: int, chunksEmbedded?: int }
  // The polling UI reads this to drive the progress bar.
  progress       Json         @default("{}")
  // Per-type extras. Includes:
  //   - log: bounded array (last 50) of { ts, level, text } — source-detail timeline
  //   - rawContent: original text for MANUAL sources, used by reingestSource
  //   - softCapReached: bool, set when MAX_CHUNKS_PER_TENANT was crossed during ingest
  //   - mime: file MIME for FILE sources
  metadata       Json         @default("{}")
  lastIngestedAt DateTime?
  // Phase 8 freshness signal. Distinct from lastIngestedAt: an operator can
  // assert "this content is still correct" without re-crawling. Surfaced in
  // the UI as a stale badge once max(lastIngestedAt, lastVerifiedAt) is older
  // than DOCUMENT_STALE_AFTER_DAYS (45) — see src/server/knowledge/limits.ts.
  lastVerifiedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model KnowledgeChunk {
  id           String                       @id @default(cuid())
  sourceId     String
  tenantId     String
  content      String
  // Voyage-3-large primary, OpenAI text-embedding-3-small fallback — both at 1024 dims.
  // Null until the embed-worker has attached a vector. Indexed via HNSW (raw SQL).
  embedding    Unsupported("vector(1024)")?
  // Postgres-generated column: to_tsvector('simple', content). 'simple' config (no
  // stemming, no stopwords) is required because we mix AR/FR/EN/Darija. Indexed via GIN.
  // Prisma never writes this column — the GENERATED ALWAYS clause makes it Postgres-managed.
  searchVector Unsupported("tsvector")?    @default(dbgenerated("to_tsvector('simple'::regconfig, content)"))
  tokenCount   Int
  // Per-chunk: { url?: string, headingPath: string[], position: number, sourceType: SourceType }
  metadata     Json                         @default("{}")
  createdAt    DateTime                     @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceId])
  // The pgvector HNSW index on `embedding` cannot be expressed in PSL today
  // (Prisma 6.1 only knows BTree/Hash/Gist/Gin/SpGist/Brin). It exists in the
  // database (created via raw SQL in 20260427235200_add_knowledge_models) and
  // is queried with SET LOCAL hnsw.ef_search in src/server/knowledge/retriever.ts.
  // `prisma migrate diff` will report this index as schema-side missing — that
  // gap is intentional; do not "fix" it by adding a non-HNSW @@index.
  // Lexical full-text index is supported and declared:
  @@index([searchVector], type: Gin, map: "KnowledgeChunk_searchVector_gin")
}

// =====================================================================
// Channels (Phase 6 — widget; WHATSAPP/INSTAGRAM scaffolded in 6/7)
// =====================================================================
//
// Channel: a tenant-connected messaging surface. `config` is per-type and
// schema-less in Prisma — typed in src/server/db/channels.ts:
//   - WIDGET:   { publicKey: string, displayName?: string, themeAccent?: string, allowedOrigins?: string[] }
//   - WHATSAPP / INSTAGRAM: provider metadata (Phase 6/7).
// `credentials` holds encrypted-at-rest secrets (empty {} for WIDGET).
//
// `(tenantId, type)` is unique: one channel per type per tenant in v1.
//
// The widget public-key lookup is served by a partial UNIQUE B-tree on
// the JSON path `config->>'publicKey'`. PSL can't express it (no JSON
// path indexes, no partial-WHERE by enum value), so it lives as raw SQL
// in 20260428xxxxxx_add_channel_models — same pattern as the HNSW index
// on KnowledgeChunk.embedding. `prisma migrate diff` will permanently
// report it as schema-side missing; that gap is intentional.
//
// Customer: unique per (tenantId, channelType, externalId). Widgets mint
// a UUID client-side; that UUID is the externalId.
//
// Conversation: a thread. Widget resume rule lives in
// src/server/channels/widget/limits.ts (CONVERSATION_RESUME_MAX_AGE_MS).
//
// Message: a single message. aiMetadata is the orchestrator's diagnostic
// envelope (typed in src/server/db/conversations.ts).

model Channel {
  id          String        @id @default(cuid())
  tenantId    String
  type        ChannelType
  displayName String
  status      ChannelStatus @default(CONNECTED)
  config      Json          @default("{}")
  credentials Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Customer {
  id          String      @id @default(cuid())
  tenantId    String
  externalId  String
  channelType ChannelType
  name        String?
  phone       String?
  email       String?
  metadata    Json        @default("{}")
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, channelType, externalId])
  @@index([tenantId])
}

model Conversation {
  id             String             @id @default(cuid())
  tenantId       String
  customerId     String
  channelId      String
  status         ConversationStatus @default(ACTIVE)
  aiEnabled      Boolean            @default(true)
  assignedUserId String?
  lastMessageAt  DateTime           @default(now())
  summary        String?
  language       String?
  sentiment      String?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assignedUser  User?          @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages      Message[]
  knowledgeGaps KnowledgeGap[]

  // Widget resume lookup: WHERE tenantId=? AND customerId=? AND status='ACTIVE' ORDER BY lastMessageAt DESC LIMIT 1
  @@index([tenantId, customerId, status, lastMessageAt(sort: Desc)])
  // Live conversations list: WHERE tenantId=? ORDER BY lastMessageAt DESC
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([channelId])
  @@index([assignedUserId])
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  tenantId       String
  direction      MessageDirection
  sender         MessageSender
  senderUserId   String?
  content        String
  contentType    MessageContentType @default(TEXT)
  mediaUrl       String?
  aiMetadata     Json?
  // Phase 6: provider's message ID for non-widget channels (360dialog,
  // Meta Cloud, IG, FB). Two uses:
  //   1. INBOUND idempotency — webhook retries are common; dedupe by this
  //      before recordInboundMessage on the inbound path.
  //   2. OUTBOUND delivery tracking — providers post status updates back
  //      (delivered / read / failed); the webhook handler resolves the
  //      target Message row via this column.
  // Widget messages always have NULL here. The composite index
  // (tenantId, providerMessageId) is partial-friendly: NULL rows are
  // skipped by the lookup query, so the index stays small.
  providerMessageId String?
  createdAt      DateTime           @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Reading conversation: WHERE conversationId=? ORDER BY createdAt ASC
  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([senderUserId])
  // Webhook idempotency + delivery-status routing for non-widget channels.
  @@index([tenantId, providerMessageId])
}

// =====================================================================
// Typed knowledge (Phase 8)
// =====================================================================
//
// Three new tables alongside KnowledgeChunk (Type 1, unstructured), each
// addressing a knowledge type the brain treats differently:
//
//   - KnowledgeItem (Type 2): structured rows with typed fields the AI can
//     reason about — products, services, packages, subscription tiers.
//     Each item carries an embedding for semantic retrieval; structured
//     fields (name, price, availability, specs) are rendered into the
//     prompt with field semantics intact, not collapsed into free text.
//
//   - QnaPair (Type 3): authoritative answer to a known question. Matched
//     by cosine similarity on the question embedding above a high
//     threshold (QNA_MATCH_THRESHOLD in retriever, default 0.85); when
//     matched the answer is injected as authoritative context the brain
//     reuses near-verbatim, only adapting language register.
//
//   - OperationalFacts (Type 5): one row per tenant; a typed JSON envelope
//     covering display name, hours, locations, contact, languages served.
//     Always available — tier-1 fields go into Block B every prompt, tier-2
//     fields are retrieved into Block C when the question warrants
//     (per Gate-1 K5 override).
//
// Plus KnowledgeGap (gap log): customer questions the AI couldn't answer,
// captured by the caller of runBrain when escalation === "OUTSIDE_SCOPE",
// clustered for an operator-facing digest (P8g).
//
// Same Unsupported-vector / GENERATED-tsvector pattern as KnowledgeChunk
// — embedding columns are pgvector vector(1024), HNSW indexed via raw SQL
// in the migration since Prisma's PSL can't model HNSW. CLAUDE.md §6 strip
// list is updated for the new index names.

model KnowledgeItem {
  id           String  @id @default(cuid())
  tenantId     String
  // Display name shown in the dashboard and rendered into prompts.
  name         String
  // Free-form taxonomy. Per Gate-1 decision A: loose now; per-category
  // form templates (and stricter validation) come later via specs._template_id
  // without a schema change.
  category     String?
  // Stable external identifier for future Odoo / CRM sync. NULL for items
  // created manually. Composite-unique with tenantId so re-imports dedupe.
  externalId   String?

  sku          String?
  brand        String?
  // ISO 4217 (e.g. "DZD", "USD", "EUR"). Free-form to allow vertical
  // exceptions (e.g. service businesses with no currency).
  currency     String?
  // Stored as cents to avoid float. The dashboard form / API surface
  // present this as decimal currency with the `currency` symbol.
  priceCents   Int?
  availability ItemAvailability @default(UNKNOWN)
  description  String?

  // Schema-less in Prisma; typed in src/server/db/items.ts (P8b).
  // Reserved keys:
  //   _template_id?: string — points to a category template for form
  //                            rendering; opaque at this layer.
  // All other keys are free-form spec fields (color, size, weight, etc.).
  specs        Json    @default("{}")

  // Voyage-3-large primary, OpenAI text-embedding-3-small fallback —
  // shared 1024-dim with KnowledgeChunk so the embed worker is provider-
  // agnostic. Null until the embed job has attached a vector.
  embedding    Unsupported("vector(1024)")?
  // GENERATED ALWAYS column managed via raw SQL in the migration. The PSL
  // @default(dbgenerated(...)) is a stub — Prisma uses it to suppress diff
  // drift, but the actual GENERATED expression is defined in the migration
  // so it can include weighted concatenation across name / brand / sku /
  // description (CLAUDE.md §6 documents this pattern for KnowledgeChunk).
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(name, ''))"))

  // Phase 8 freshness signal — same semantics as KnowledgeSource.lastVerifiedAt:
  // operator-asserted "still correct," distinct from updatedAt.
  lastVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Re-imports against an external system dedupe by (tenantId, externalId).
  // NULL externalIds (manual entries) are allowed in any quantity per
  // Postgres NULLS-DISTINCT default.
  @@unique([tenantId, externalId])
  @@index([tenantId, category])
  @@index([tenantId, name])
  @@index([tenantId, createdAt(sort: Desc)])
  // Lexical full-text index on the GENERATED searchVector. The HNSW index
  // on `embedding` cannot be expressed in PSL; it lives as raw SQL in the
  // migration alongside the GIN index below.
  @@index([searchVector], type: Gin, map: "KnowledgeItem_searchVector_gin")
}

model QnaPair {
  id                 String  @id @default(cuid())
  tenantId           String
  // The canonical question text shown in the dashboard.
  question           String
  // Application-set on insert/update: lower(trim(question)) with collapsed
  // whitespace. Used for dedupe via the (tenantId, normalizedQuestion)
  // composite unique. Application-managed (not GENERATED) because lower()
  // can be STABLE under non-C collations — see CLAUDE.md §6 GENERATED
  // discipline note.
  normalizedQuestion String
  // The authoritative answer to this question. Up to ~4000 chars (longer
  // answers should be unstructured docs, not Q&A).
  answer             String
  // Free-form tags for filtering in the dashboard (e.g. "shipping",
  // "returns"). Postgres text[].
  tags               String[] @default([])

  // Author-asserted language of the question — supported codes match
  // SUPPORTED_LANGUAGES in src/lib/validators.ts (ar / fr / en / darija).
  // Null = "unspecified," matched cross-language regardless of languageLock.
  language           String?
  // Per Gate-1 decision C (override): when true, this Q&A only matches
  // queries the brain detects to be in `language`. Default off — most
  // tenants want a French Q&A to fire on an Arabic question with the
  // brain handling translation in the reply.
  languageLock       Boolean  @default(false)

  // Optional provenance — where the canonical answer came from.
  sourceUrl          String?

  // Same 1024-dim shared-vector pattern. Embeds the QUESTION, not the
  // answer — semantic match is on what the customer asked.
  questionEmbedding  Unsupported("vector(1024)")?

  // Operator-asserted "still correct" timestamp; freshness display.
  lastVerifiedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite unique enforces dedupe per tenant. Two operators pasting
  // "What are your hours?" and "what are your hours?" both normalize to
  // the same key and the second insert fails (caught by the helper, which
  // surfaces a friendly error pointing to the existing pair).
  @@unique([tenantId, normalizedQuestion])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, language])
}

model OperationalFacts {
  // Singleton per tenant — tenantId is the primary key. One row holds the
  // entire typed envelope; field-level edits patch the JSON in place.
  tenantId  String   @id
  // Schema-less in Prisma; typed in src/server/db/operational-facts.ts (P8b).
  // Tier-1 fields (always-in-Block-B): displayName, primaryLanguage,
  // primaryContact, languagesServed.
  // Tier-2 fields (retrieve into Block C when the question warrants):
  // hours, locations, exceptions, currency, serviceArea, etc.
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KnowledgeGap {
  id             String        @id @default(cuid())
  tenantId       String
  // Optional: the conversation that produced this gap. SetNull (not Cascade)
  // so the digest survives conversation deletion — the gap question itself
  // is what's interesting for the operator's "knowledge to add" workflow.
  conversationId String?

  // The customer's unanswered question. Stored verbatim (the operator
  // sees what was actually said, including language / register).
  question       String
  // Brain-detected language of the question, when available.
  language       String?

  // Embedding of `question`, used by the P8g clusterer to group similar
  // questions (cosine similarity > 0.85, simple greedy clustering within
  // the last 30 days per Gate-1 risk discussion). Null until the embed
  // job runs.
  embedding      Unsupported("vector(1024)")?

  // Set by the clusterer; null until clustered. Same value across all
  // gaps in a cluster. Indexed for the digest list.
  clusterKey     String?
  // Operator dismisses or marks as resolved (e.g. after creating a Q&A
  // from the gap, per Gate-1 D).
  resolved       Boolean       @default(false)
  resolvedAt     DateTime?

  createdAt      DateTime      @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Digest list: WHERE tenantId=? AND resolved=false ORDER BY createdAt DESC
  @@index([tenantId, resolved, createdAt(sort: Desc)])
  // Cluster lookup: WHERE tenantId=? AND clusterKey=?
  @@index([tenantId, clusterKey])
  @@index([conversationId])
}
