// Prisma schema — multi-tenancy foundation (Phase 1)
// Phase 1 scope: Tenant, User, TenantUser + NextAuth tables (Account,
// Session, VerificationToken). Phase 2 will use the NextAuth tables; later
// phases add Channel, Customer, Conversation, Message, KnowledgeSource,
// KnowledgeChunk, Escalation, AuditLog, UsageRecord per MASTER_PLAN §6.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  // `vector` is pgvector — the only extension our code actively uses (Phase 3
  // embeddings); Supabase installs it in `public`. The other four are
  // pre-installed by Supabase across two dedicated schemas: the standard
  // utilities live in `extensions`, and `supabase_vault` lives in `vault`.
  // Schema annotations match the actual DB layout so drift detection passes.
  extensions = [pg_stat_statements(schema: "extensions"), pgcrypto(schema: "extensions"), plpgsql, supabase_vault(schema: "vault"), uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

// =====================================================================
// Multi-tenancy core
// =====================================================================

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SourceType {
  WEBSITE
  FILE
  MANUAL
}

enum SourceStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  WIDGET
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ConversationStatus {
  ACTIVE
  PAUSED
  CLOSED
  HUMAN_HANDLING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN_AGENT
}

enum MessageContentType {
  TEXT
  IMAGE
  VOICE
  FILE
}

model Tenant {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  logoUrl          String?
  accentColor      String? // hex; falls back to design-system violet at the app layer
  plan             Plan         @default(FREE)
  stripeCustomerId String?      @unique
  settings         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  members          TenantUser[]
  lastUsedByUsers  User[]            @relation("UserLastTenant")
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  channels         Channel[]
  customers        Customer[]
  conversations    Conversation[]
  messages         Message[]

  @@index([slug])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime? // NextAuth
  name          String?
  image         String?
  // Platform-level admin flag — gates the /admin super-admin route. Toggled
  // out-of-band (e.g. via prisma studio); no self-service surface in v1.
  isSuperAdmin  Boolean      @default(false)
  // Most-recently-active workspace, set on tenant switch and consulted by
  // /post-auth to decide where to land the user. Cleared if the tenant is
  // deleted (SetNull rather than Cascade).
  lastUsedTenantId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenants               TenantUser[]
  accounts              Account[]
  sessions              Session[]
  lastUsedTenant        Tenant?        @relation("UserLastTenant", fields: [lastUsedTenantId], references: [id], onDelete: SetNull)
  assignedConversations Conversation[] @relation("ConversationAssignedUser")
  sentMessages          Message[]      @relation("MessageSenderUser")

  @@index([email])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

// =====================================================================
// NextAuth — wired now so Phase 2 doesn't need a schema migration on day 1
// (https://authjs.dev/getting-started/adapters/prisma)
// =====================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
// Knowledge (Phase 3)
// =====================================================================
//
// KnowledgeSource is the unit a tenant manages in the UI: a website crawl,
// a parsed file, or a manual entry. KnowledgeChunk holds the embedded text
// that retrieval queries.
//
// Two columns are declared as Unsupported because Prisma's PSL can't model
// them: `embedding` (pgvector vector(1024)) and `searchVector` (Postgres
// tsvector, populated as a GENERATED column). Both are read/written via raw
// SQL in src/server/db/knowledge.ts. Prisma still tracks them for drift
// detection so prisma migrate dev stays happy.
//
// Indexes (HNSW on embedding, GIN on searchVector) and the GENERATED clause
// on searchVector are added via raw SQL appended to the init migration.

model KnowledgeSource {
  id             String       @id @default(cuid())
  tenantId       String
  type           SourceType
  // Display name: hostname for WEBSITE, filename for FILE, user-supplied for MANUAL.
  name           String
  // Root URL for WEBSITE; storage path for FILE; null for MANUAL.
  sourceUrl      String?
  status         SourceStatus @default(PENDING)
  // Last error message captured when status=ERROR. Cleared on re-ingest.
  error          String?
  // Live progress from the worker — shape:
  //   { totalPages?: int, pagesCrawled?: int, totalChunks?: int, chunksEmbedded?: int }
  // The polling UI reads this to drive the progress bar.
  progress       Json         @default("{}")
  // Per-type extras. Includes:
  //   - log: bounded array (last 50) of { ts, level, text } — source-detail timeline
  //   - rawContent: original text for MANUAL sources, used by reingestSource
  //   - softCapReached: bool, set when MAX_CHUNKS_PER_TENANT was crossed during ingest
  //   - mime: file MIME for FILE sources
  metadata       Json         @default("{}")
  lastIngestedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model KnowledgeChunk {
  id           String                       @id @default(cuid())
  sourceId     String
  tenantId     String
  content      String
  // Voyage-3-large primary, OpenAI text-embedding-3-small fallback — both at 1024 dims.
  // Null until the embed-worker has attached a vector. Indexed via HNSW (raw SQL).
  embedding    Unsupported("vector(1024)")?
  // Postgres-generated column: to_tsvector('simple', content). 'simple' config (no
  // stemming, no stopwords) is required because we mix AR/FR/EN/Darija. Indexed via GIN.
  // Prisma never writes this column — the GENERATED ALWAYS clause makes it Postgres-managed.
  searchVector Unsupported("tsvector")?    @default(dbgenerated("to_tsvector('simple'::regconfig, content)"))
  tokenCount   Int
  // Per-chunk: { url?: string, headingPath: string[], position: number, sourceType: SourceType }
  metadata     Json                         @default("{}")
  createdAt    DateTime                     @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sourceId])
  // The pgvector HNSW index on `embedding` cannot be expressed in PSL today
  // (Prisma 6.1 only knows BTree/Hash/Gist/Gin/SpGist/Brin). It exists in the
  // database (created via raw SQL in 20260427235200_add_knowledge_models) and
  // is queried with SET LOCAL hnsw.ef_search in src/server/knowledge/retriever.ts.
  // `prisma migrate diff` will report this index as schema-side missing — that
  // gap is intentional; do not "fix" it by adding a non-HNSW @@index.
  // Lexical full-text index is supported and declared:
  @@index([searchVector], type: Gin, map: "KnowledgeChunk_searchVector_gin")
}

// =====================================================================
// Channels (Phase 6 — widget; WHATSAPP/INSTAGRAM scaffolded in 6/7)
// =====================================================================
//
// Channel: a tenant-connected messaging surface. `config` is per-type and
// schema-less in Prisma — typed in src/server/db/channels.ts:
//   - WIDGET:   { publicKey: string, displayName?: string, themeAccent?: string, allowedOrigins?: string[] }
//   - WHATSAPP / INSTAGRAM: provider metadata (Phase 6/7).
// `credentials` holds encrypted-at-rest secrets (empty {} for WIDGET).
//
// `(tenantId, type)` is unique: one channel per type per tenant in v1.
//
// The widget public-key lookup is served by a partial UNIQUE B-tree on
// the JSON path `config->>'publicKey'`. PSL can't express it (no JSON
// path indexes, no partial-WHERE by enum value), so it lives as raw SQL
// in 20260428xxxxxx_add_channel_models — same pattern as the HNSW index
// on KnowledgeChunk.embedding. `prisma migrate diff` will permanently
// report it as schema-side missing; that gap is intentional.
//
// Customer: unique per (tenantId, channelType, externalId). Widgets mint
// a UUID client-side; that UUID is the externalId.
//
// Conversation: a thread. Widget resume rule lives in
// src/server/channels/widget/limits.ts (CONVERSATION_RESUME_MAX_AGE_MS).
//
// Message: a single message. aiMetadata is the orchestrator's diagnostic
// envelope (typed in src/server/db/conversations.ts).

model Channel {
  id          String        @id @default(cuid())
  tenantId    String
  type        ChannelType
  displayName String
  status      ChannelStatus @default(CONNECTED)
  config      Json          @default("{}")
  credentials Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Customer {
  id          String      @id @default(cuid())
  tenantId    String
  externalId  String
  channelType ChannelType
  name        String?
  phone       String?
  email       String?
  metadata    Json        @default("{}")
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, channelType, externalId])
  @@index([tenantId])
}

model Conversation {
  id             String             @id @default(cuid())
  tenantId       String
  customerId     String
  channelId      String
  status         ConversationStatus @default(ACTIVE)
  aiEnabled      Boolean            @default(true)
  assignedUserId String?
  lastMessageAt  DateTime           @default(now())
  summary        String?
  language       String?
  sentiment      String?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]

  // Widget resume lookup: WHERE tenantId=? AND customerId=? AND status='ACTIVE' ORDER BY lastMessageAt DESC LIMIT 1
  @@index([tenantId, customerId, status, lastMessageAt(sort: Desc)])
  // Live conversations list: WHERE tenantId=? ORDER BY lastMessageAt DESC
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([channelId])
  @@index([assignedUserId])
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  tenantId       String
  direction      MessageDirection
  sender         MessageSender
  senderUserId   String?
  content        String
  contentType    MessageContentType @default(TEXT)
  mediaUrl       String?
  aiMetadata     Json?
  // Phase 6: provider's message ID for non-widget channels (360dialog,
  // Meta Cloud, IG, FB). Two uses:
  //   1. INBOUND idempotency — webhook retries are common; dedupe by this
  //      before recordInboundMessage on the inbound path.
  //   2. OUTBOUND delivery tracking — providers post status updates back
  //      (delivered / read / failed); the webhook handler resolves the
  //      target Message row via this column.
  // Widget messages always have NULL here. The composite index
  // (tenantId, providerMessageId) is partial-friendly: NULL rows are
  // skipped by the lookup query, so the index stays small.
  providerMessageId String?
  createdAt      DateTime           @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)

  // Reading conversation: WHERE conversationId=? ORDER BY createdAt ASC
  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([senderUserId])
  // Webhook idempotency + delivery-status routing for non-widget channels.
  @@index([tenantId, providerMessageId])
}
