# =============================================================================
# messaging-ai — environment variables
#
# Copy this file to .env.local and fill in real values for development.
# Never commit .env.local. Production values go in Railway / Supabase / Upstash
# dashboards, never in this repo.
#
# Reference: MASTER_PLAN.md §11
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Database (Postgres + pgvector)
# Local dev: matches docker-compose.yml service.
# Prod: Supabase pooler URL for DATABASE_URL, direct URL for DIRECT_DATABASE_URL.
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis (queue + rate limiting)
# Local dev: matches docker-compose.yml. Prod: Upstash REST URL.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth (Phase 2)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Optional. Defaults to Resend's shared sandbox sender (only delivers to the
# email tied to your Resend account, fine for dev). Set to a verified-domain
# address before staging/prod. Format: "Name <noreply@yourdomain.com>"
EMAIL_FROM=

# -----------------------------------------------------------------------------
# AI providers (Phase 3+)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# -----------------------------------------------------------------------------
# Knowledge ingestion (Phase 3)
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=
LLAMAPARSE_API_KEY=

# Supabase Storage — uploads bucket for parsed files (private). Service-role
# key is server-only; never expose in browser code. URL is the Supabase
# project URL (https://<ref>.supabase.co).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Channels (Phase 6+)
# -----------------------------------------------------------------------------
WHATSAPP_360DIALOG_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# Billing (Phase 9)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# -----------------------------------------------------------------------------
# Observability (Phase 10)
# -----------------------------------------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=

# -----------------------------------------------------------------------------
# Encryption (used for storing tenant channel credentials)
# Generate with: openssl rand -hex 32  (must be 64 hex chars = 32 bytes)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=
